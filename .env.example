# Campus — environment template.
# Copy to  backend/.env  and fill in real values. The installer generates the
# secret values automatically on first run; this file documents every key.
# NOTHING with a real value in it is ever committed (.env is git-ignored).

# ── Core ─────────────────────────────────────────────────────────────────
CAMPUS_ENV=dev                       # dev | prod
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=                          # generated per install; 50+ random chars
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1    # + the LAN hostname/IP of the on-site server
CSRF_TRUSTED_ORIGINS=https://localhost

# ── Field-level PII encryption (see docs/PII_SECURITY.md) ────────────────
# 32 bytes, base64. Generated per install, stored by the OS keystore / a
# locked-down file — NEVER in the database, the repo, or a log line.
FIELD_ENCRYPTION_KEY=

# ── Database (bundled PostgreSQL 16) ────────────────────────────────────
POSTGRES_DB=campus
POSTGRES_USER=campus
POSTGRES_PASSWORD=                   # generated per install
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgres://campus:CHANGE_ME@127.0.0.1:5432/campus

# ── Email (on-site SMTP; email only, no SMS in v1) ─────────────────────
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=campus@localhost

# ── Front door ─────────────────────────────────────────────────────────
# The bundled Caddy serves HTTPS on the LAN and proxies /api to waitress.
PUBLIC_BASE_URL=https://localhost
API_BIND=127.0.0.1:8001              # waitress bind (behind Caddy)

# ── Retention (days) — see docs/OPERATOR_PRIVACY_CHECKLIST.md ───────────
RETENTION_PAST_STUDENT_DAYS=2555     # ~7 years; per-record-type overrides in-app
RETENTION_AUDIT_LOG_DAYS=3650

# ── Access control ───────────────────────────────────────────────────
# The Django admin is break-glass only: superuser + MFA-verified session +
# request IP on this list. Narrow to the on-site admin workstation(s).
CAMPUS_ADMIN_IP_ALLOWLIST=127.0.0.1
CAMPUS_ADMIN_REQUIRE_MFA=true
OTP_TOTP_ISSUER=Campus               # label shown in the authenticator app
# django-axes lockout
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_HOURS=1

# ── Feature toggles ───────────────────────────────────────────────────
FEATURE_STUDENT_LOGINS=false         # enable for older grades
FEATURE_PAYMENTS_GATEWAY=manual      # manual (only real option in v1); 'stripe' is a stub
