# Campus — bundled reverse proxy / HTTPS front door.
# install.ps1 templates {$CAMPUS_HOST}, {$API_BIND} and {$CAMPUS_WEB_ROOT}
# from the first-run wizard. Caddy runs as a Windows service.
#
# For a LAN host with no public DNS, Caddy's internal CA (self-signed,
# trusted after `caddy trust` on client machines) via `tls internal`.

{$CAMPUS_HOST:localhost} {
	encode gzip zstd

	# --- dynamic: Django (waitress) ---------------------------------------
	# API, the break-glass admin, Django's own collected static (admin +
	# DRF browsable API assets), and uploaded media all go to the app.
	@dynamic path /api/* /admin/* /static/* /media/*
	handle @dynamic {
		reverse_proxy {$API_BIND:127.0.0.1:8001}
	}

	# --- everything else: the exported Next.js SPA -----------------------
	# Served straight off disk by Caddy - the static export is bundled at
	# {app}\app\frontend_out. try_files covers Next's per-route index.html
	# folders and falls back to the SPA shell for client-side routes.
	handle {
		root * {$CAMPUS_WEB_ROOT:./frontend_out}
		try_files {path} {path}/index.html {path}.html /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
	}

	tls internal
}
